            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const content = e.target.result;
                    // For large files, we might need to chunk this
                    if (content.length > 100000) {
                        alert('Fichier trop grand. Limite: 100KB');
                        return;
                    }
                    
                    hostConnection.send({ 
                        type: 'file_upload', 
                        filename: file.name, 
                        content: content 
                    });
                    showNotification('📤 Fichier envoyé: ' + file.name);
                    fileInput.value = '';
                } catch (err) {
                    console.error('Error uploading file:', err);
                    alert('Erreur lors de l\'envoi du fichier');
                }
            };
            reader.readAsDataURL(file);
        }

