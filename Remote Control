                conn.on('open', () => {
                    document.getElementById('connectionStatus').textContent = '✅ Tablette connectée !';
                    document.getElementById('connectionStatus').className = 'status connected';
                });
                
                conn.on('data', (data) => {
                    if (data.type === 'request_webcam' && webcamStream) {
                        startWebcamCall(conn.peer);
                    } else if (data.type === 'request_screen' && screenStream) {
                        startScreenCall(conn.peer);
                    } else if (data.type === 'request_microphone' && microphoneStream) {
                        startMicrophoneCall(conn.peer);
                    } else if (data.type === 'alert') {
                        handleRemoteAlert();
                    } else if (data.type === 'system_info_request') {
                        handleSystemInfoRequest(conn);
                    } else if (data.type === 'volume_change') {
                        handleVolumeChange(data.value);
                    } else if (data.type === 'remote_message') {
                        handleRemoteMessage(data.message);
                    } else if (data.type === 'open_url') {
                        handleOpenURL(data.url);
                    } else if (data.type === 'speak_text') {
                        handleSpeakText(data.text);
                    } else if (data.type === 'play_sound') {
                        handlePlaySound();
                    } else if (data.type === 'trigger_download') {
                        handleTriggerDownload(conn);
                    } else if (data.type === 'play_sound_effect') {
                        handlePlaySoundEffect(data.effect);
                    } else if (data.type === 'virtual_keyboard_text') {
                        handleVirtualKeyboardText(data.text);
                    } else if (data.type === 'virtual_key') {
                        handleVirtualKey(data.key);
                    } else if (data.type === 'video_control') {
                        handleVideoControl(data.action);
                    } else if (data.type === 'file_upload') {
                        handleFileUpload(data.filename, data.content);
                    } else if (data.type === 'file_download_request') {
                        handleFileDownloadRequest(conn, data.filename);
                    } else if (data.type === 'battery_info_request') {
                        handleBatteryInfoRequest(conn);
                    } else if (data.type === 'network_info_request') {
                        handleNetworkInfoRequest(conn);
                    } else if (data.type === 'display_image') {
                        handleDisplayImage(data.url);
