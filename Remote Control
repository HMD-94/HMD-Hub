        function captureScreenshot() {
            const video = document.getElementById('remoteScreenVideo');
            if (video.style.display === 'none' || !video.srcObject) {
                alert('Aucun flux d\'écran disponible. Activez d\'abord le partage d\'écran.');
                return;
            }

            const canvas = document.createElement('canvas');
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(video, 0, 0);

            currentScreenshot = canvas.toDataURL('image/png');
            const preview = document.getElementById('screenshotPreview');
            preview.src = currentScreenshot;
            preview.style.display = 'block';

            document.getElementById('downloadScreenshot').style.display = 'block';
            showNotification('Capture d\'écran effectuée !');
        }

