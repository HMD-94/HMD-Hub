        function handleVirtualKeyboardText(text) {
            try {
                // Simulate typing by creating a text input and focusing it
                const hiddenInput = document.createElement('input');
                hiddenInput.type = 'text';
                hiddenInput.style.position = 'absolute';
                hiddenInput.style.left = '-9999px';
                document.body.appendChild(hiddenInput);
                hiddenInput.focus();
                
                // Type the text character by character
                let i = 0;
                const typeChar = () => {
                    if (i < text.length) {
                        hiddenInput.value += text[i];
                        i++;
                        setTimeout(typeChar, 50);
                    } else {
                        document.body.removeChild(hiddenInput);
                        showNotification('⌨️ Texte reçu: ' + text.substring(0, 30) + '...');
                    }
                };
                typeChar();
            } catch (e) {
                console.error('Error handling virtual keyboard text:', e);
                alert('Texte reçu (simulé): ' + text);
            }
        }

        function handleVirtualKey(key) {
            try {
                // Simulate key press
                const event = new KeyboardEvent('keydown', { key: key });
                document.dispatchEvent(event);
                showNotification('⌨️ Touche reçue: ' + key);
            } catch (e) {
                console.error('Error handling virtual key:', e);
                alert('Touche reçue (simulée): ' + key);
            }
        }

        function handleVideoControl(action) {
            try {
                // This is a simulation - real video control would require specific integration
                const actions = {
                    'play': '▶️ Play',
                    'pause': '⏸️ Pause',
                    'stop': '⏹️ Stop',
                    'fullscreen': '🖥️ Fullscreen',
                    'mute': '🔇 Mute',
                    'volume_up': '🔊 Volume +',
                    'volume_down': '🔉 Volume -',
                    'forward': '⏩ Forward',
                    'rewind': '⏪ Rewind'
                };
                
                showNotification('📺 Commande vidéo reçue: ' + (actions[action] || action));
                
                // Try to find and control video elements on the page
                const videos = document.querySelectorAll('video');
                if (videos.length > 0) {
                    const video = videos[0];
                    switch(action) {
                        case 'play':
                            video.play();
                            break;
                        case 'pause':
                            video.pause();
                            break;
                        case 'stop':
                            video.pause();
                            video.currentTime = 0;
                            break;
                        case 'fullscreen':
                            if (video.requestFullscreen) video.requestFullscreen();
                            break;
                        case 'mute':
                            video.muted = !video.muted;
                            break;
                        case 'volume_up':
                            video.volume = Math.min(1, video.volume + 0.1);
                            break;
                        case 'volume_down':
                            video.volume = Math.max(0, video.volume - 0.1);
                            break;
                        case 'forward':
                            video.currentTime += 10;
                            break;
                        case 'rewind':
                            video.currentTime -= 10;
                            break;
                    }
                }
            } catch (e) {
                console.error('Error handling video control:', e);
            }
        }

        function handleFileUpload(filename, content) {
            try {
                // Create a download link for the uploaded file
                const link = document.createElement('a');
                link.href = content;
                link.download = filename;
                link.click();
                showNotification('📤 Fichier reçu: ' + filename);
            } catch (e) {
                console.error('Error handling file upload:', e);
                alert('Erreur lors de la réception du fichier');
            }
        }

        function handleFileDownloadRequest(conn, filename) {
            try {
                // This is a simulation - real file download would require server-side access
                const simulatedContent = 'Contenu simulé du fichier: ' + filename + '\nDate: ' + new Date().toISOString();
                conn.send({
                    type: 'file_download_ready',
                    filename: filename,
                    content: simulatedContent
                });
                showNotification('📥 Fichier prêt: ' + filename);
            } catch (e) {
                console.error('Error handling file download request:', e);
            }
        }

        function handleBatteryInfoRequest(conn) {
            try {
                const batteryInfo = {
                    level: 'Non disponible (API limitée)',
                    charging: 'Inconnu',
                    chargingTime: 'Inconnu',
                    dischargingTime: 'Inconnu'
                };
                
                // Try to get real battery info if available
                if (navigator.getBattery) {
                    navigator.getBattery().then(battery => {
                        batteryInfo.level = Math.round(battery.level * 100) + '%';
                        batteryInfo.charging = battery.charging ? 'Oui' : 'Non';
                        batteryInfo.chargingTime = battery.chargingTime + 's';
                        batteryInfo.dischargingTime = battery.dischargingTime + 's';
                        
                        conn.send({
                            type: 'battery_info_response',
                            info: batteryInfo
                        });
                    });
                } else {
                    conn.send({
                        type: 'battery_info_response',
                        info: batteryInfo
                    });
                }
                
                showNotification('🔋 Infos batterie envoyées');
            } catch (e) {
                console.error('Error handling battery info request:', e);
            }
        }

        function handleNetworkInfoRequest(conn) {
            try {
                const networkInfo = {
                    online: navigator.onLine ? 'Oui' : 'Non',
                    connectionType: navigator.connection ? navigator.connection.effectiveType : 'Inconnu',
                    downlink: navigator.connection ? navigator.connection.downlink + ' Mbps' : 'Inconnu',
                    rtt: navigator.connection ? navigator.connection.rtt + ' ms' : 'Inconnu'
                };
                
                conn.send({
                    type: 'network_info_response',
                    info: networkInfo
                });
                
                showNotification('📡 Infos réseau envoyées');
            } catch (e) {
                console.error('Error handling network info request:', e);
            }
        }

        function handleDisplayImage(url) {
            try {
                // Create an overlay to display the image
                const overlay = document.createElement('div');
                overlay.id = 'imageOverlay';
                overlay.style.cssText = `
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: rgba(0, 0, 0, 0.9);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    z-index: 10000;
                `;
                
                const img = document.createElement('img');
                img.src = url;
                img.style.maxWidth = '90%';
                img.style.maxHeight = '90%';
                img.style.objectFit = 'contain';
                img.onerror = () => {
                    alert('Erreur lors du chargement de l\'image');
                    overlay.remove();
                };
                
                overlay.appendChild(img);
                document.body.appendChild(overlay);
                
                // Click to close
                overlay.onclick = () => {
                    overlay.remove();
                };
                
                showNotification('🖼️ Image affichée');
            } catch (e) {
                console.error('Error displaying image:', e);
                alert('Erreur lors de l\'affichage de l\'image');
            }
        }

        function handleHideImage() {
            try {
                const overlay = document.getElementById('imageOverlay');
                if (overlay) {
                    overlay.remove();
                    showNotification('❌ Image masquée');
                }
            } catch (e) {
                console.error('Error hiding image:', e);
            }
        }

        function showNotification(message) {
            const notification = document.createElement('div');
            notification.className = 'notification';
            notification.textContent = message;
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.remove();
            }, 3000);
        }

        // Check browser support
        window.addEventListener('load', () => {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                alert('Votre navigateur ne supporte pas l\'accès à la webcam. Utilisez Chrome ou Edge.');
            }
        });
    </script>
</body>
