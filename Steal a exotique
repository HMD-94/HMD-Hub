-- Système de drag amélioré (sans bug joystick)
local isDragging = false
local dragStart = nil
local startPos = nil

-- Variables pour détecter clic vs drag
local dragThreshold = 10 -- Seuil de déplacement pour considérer comme drag
local hasDragged = false

FButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDragging = true
		dragStart = input.Position
		startPos = FButton.Position
		hasDragged = false
	end
end)

FButton.InputChanged:Connect(function(input)
	if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		local distance = delta.Magnitude
		
		if distance > dragThreshold then
			hasDragged = true
			local newPos = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
			FButton.Position = newPos
		end
	end
end)

FButton.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDragging = false
		
		-- Si c'était un clic (pas un drag), exécuter QUICK TP DIRECTEMENT
		if not hasDragged then
			-- EXÉCUTION DIRECTE - PAS DE SIMULATION CLAVIER!
			quickTP()
			
			-- Effet visuel
			FButton.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
			task.wait(0.2)
			FButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
		end
	end
end)

