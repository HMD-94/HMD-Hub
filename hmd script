-- =====================
-- BUTTON CREATION
-- =====================
local function createButton(data)
	local btn = Instance.new("TextButton")
	btn.Text = data.name
	btn.BackgroundColor3 = Color3.fromRGB(15,15,15)
	btn.BorderSizePixel = 3
	btn.Font = Enum.Font.SourceSans
	btn.TextWrapped = true
	btn.TextColor3 = Color3.new(1,1,1)
	btn.ClipsDescendants = true
	
	local isFavorite = table.find(settings.favorites, data.name) ~= nil
	
	-- Star icon for favorites
	local star = Instance.new("TextLabel")
	star.Parent = btn
	star.Size = UDim2.new(0, 20, 0, 20)
	star.Position = UDim2.new(1, -22, 0, 2)
	star.BackgroundTransparency = 1
	star.Text = isFavorite and "★" or "☆"
	star.TextSize = 18
	star.TextColor3 = Color3.fromRGB(255, 215, 0)
	star.ZIndex = 5
	
	-- Tooltip
	local tooltip = Instance.new("TextLabel")
	tooltip.Parent = btn
	tooltip.Size = UDim2.new(1, 0, 0, 0)
	tooltip.Position = UDim2.new(0, 0, 1, 0)
	tooltip.BackgroundColor3 = Color3.fromRGB(5,5,5)
	tooltip.BorderSizePixel = 1
	tooltip.Text = data.description or "No description"
	tooltip.TextSize = 12
	tooltip.Font = Enum.Font.SourceSans
	tooltip.TextColor3 = Color3.new(1,1,1)
	tooltip.TextWrapped = true
	tooltip.Visible = false
	tooltip.ZIndex = 100
	
	btn.MouseEnter:Connect(function()
		tooltip.Size = UDim2.new(1, 0, 0, 30)
		tooltip.Visible = true
	end)
	
	btn.MouseLeave:Connect(function()
		tooltip.Visible = false
	end)
	
	-- Click to run script
	btn.MouseButton1Click:Connect(function()
		local success, err = pcall(function()
			loadstring(game:HttpGet(data.url))()
		end)
		
		if success then
			showNotification("✓ " .. data.name .. " loaded!", false)
			-- Add to recently used
			table.insert(settings.recentlyUsed, 1, data.name)
			if #settings.recentlyUsed > 10 then
				table.remove(settings.recentlyUsed, 11)
			end
			if writefile then saveSettings() end
		else
			showNotification("✗ Failed to load " .. data.name, true)
		end
	end)
	
	-- Right click or long press to favorite (mobile support)
	local holdTime = 0
	local holding = false
	
	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.Touch then
			holding = true
			holdTime = 0
			task.spawn(function()
				while holding do
					task.wait(0.1)
					holdTime = holdTime + 0.1
					if holdTime >= 0.5 and input.UserInputType == Enum.UserInputType.Touch then
						holding = false
						-- Toggle favorite
						local idx = table.find(settings.favorites, data.name)
						if idx then
							table.remove(settings.favorites, idx)
							star.Text = "☆"
							showNotification("Removed from favorites", false)
						else
							table.insert(settings.favorites, data.name)
							star.Text = "★"
							showNotification("Added to favorites", false)
						end
						if writefile then saveSettings() end
						break
					end
				end
			end)
		end
	end)
	
	btn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			-- Toggle favorite
			local idx = table.find(settings.favorites, data.name)
			if idx then
				table.remove(settings.favorites, idx)
				star.Text = "☆"
				showNotification("Removed from favorites", false)
			else
				table.insert(settings.favorites, data.name)
				star.Text = "★"
				showNotification("Added to favorites", false)
			end
			if writefile then saveSettings() end
		end
		holding = false
	end)
	
	return btn, data
end

