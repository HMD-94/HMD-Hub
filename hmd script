local function saveSettings()
	writefile("HMD_Settings.json", HttpService:JSONEncode(settings))
end

local function loadSettings()
	if isfile and isfile("HMD_Settings.json") then
		local success, data = pcall(function()
			return HttpService:JSONDecode(readfile("HMD_Settings.json"))
		end)
		if success then
			for k,v in pairs(data) do
				settings[k] = v
			end
		end
	end
end

