-- =====================
-- FILTER & LAYOUT SYSTEM
-- =====================
local function filterButtons(filter, searchText)
	local visibleButtons = {}
	searchText = searchText and searchText:lower() or ""
	
	for _, btnInfo in ipairs(buttons) do
		local visible = true
		
		-- Filter by category
		if filter == "favorites" then
			visible = table.find(settings.favorites, btnInfo.data.name) ~= nil
		elseif filter == "recent" then
			visible = table.find(settings.recentlyUsed, btnInfo.data.name) ~= nil
		end
		
		-- Filter by search
		if visible and searchText ~= "" then
			visible = btnInfo.data.name:lower():find(searchText) ~= nil
		end
		
		if visible then
			table.insert(visibleButtons, btnInfo)
		end
		
		btnInfo.button.Visible = visible
	end
	
	return visibleButtons
end

local function updateLayout()
	local visibleButtons = filterButtons(currentFilter, searchBar.Text)
	local w = scrollFrame.AbsoluteSize.X
	local paddingX, paddingY = 12, 10
	local scrollbarWidth = 12
	
	if settings.viewMode == "grid" then
		local cols = 2
		local btnW = (w - scrollbarWidth - (cols + 1) * paddingX) / cols
		local btnH = 50
		local txtSize = math.clamp(btnH * 0.36, 14, 20)
		
		for i, btnInfo in ipairs(visibleButtons) do
			local col = (i-1) % cols
			local row = math.floor((i-1) / cols)
			btnInfo.button.Size = UDim2.new(0, btnW, 0, btnH)
			btnInfo.button.Position = UDim2.new(
				0, paddingX + col * (btnW + paddingX),
				0, paddingY + row * (btnH + paddingY)
			)
			btnInfo.button.TextSize = txtSize
		end
		
		local totalRows = math.ceil(#visibleButtons / cols)
		local canvasHeight = paddingY + totalRows * (btnH + paddingY) + 10
		scrollFrame.CanvasSize = UDim2.new(0, 0, 0, canvasHeight)
	else
		-- List view
		local btnW = w - scrollbarWidth - 20
		local btnH = 35
		local txtSize = 16
		
		for i, btnInfo in ipairs(visibleButtons) do
			btnInfo.button.Size = UDim2.new(0, btnW, 0, btnH)
			btnInfo.button.Position = UDim2.new(0, 10, 0, (i-1) * (btnH + 5) + 5)
			btnInfo.button.TextSize = txtSize
		end
		
		local canvasHeight = #visibleButtons * (btnH + 5) + 10
		scrollFrame.CanvasSize = UDim2.new(0, 0, 0, canvasHeight)
	end
end

