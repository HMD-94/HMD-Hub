-- =====================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == settings.toggleKey and settings.keybindEnabled then
		main.Enabled = not main.Enabled
	end
end)

-- =====================
-- SAVE POSITION ON DRAG
-- =====================
frame:GetPropertyChangedSignal("Position"):Connect(function()
	if not resizing and not collapsed then
		settings.savedPosition = frame.Position
		if writefile then
			task.wait(0.5)
			saveSettings()
		end
	end
end)

-- =====================
-- RGB ANIMATION & THEME
-- =====================
local hue = 0
RunService.RenderStepped:Connect(function()
	local currentTheme = themes[settings.theme]
	local themeColor
	
	if currentTheme.animated then
		hue = (hue + 0.003) % 1
		themeColor = Color3.fromHSV(hue, 1, 1)
	else
		themeColor = currentTheme.primary
	end
	
	frame.BorderColor3 = themeColor
	titler.BorderColor3 = themeColor
	titler.TextColor3 = themeColor
	collapseBtn.TextColor3 = themeColor
	resizeSlider.TextColor3 = themeColor
	resizeSlider.BorderColor3 = themeColor
	scrollFrame.ScrollBarImageColor3 = themeColor
	searchBar.BorderColor3 = themeColor
	
	for _, btnInfo in ipairs(buttons) do
		btnInfo.button.BorderColor3 = themeColor
	end
	
	updateLayout()
end)

-- =====================
-- INITIAL SETUP
-- =====================
showNotification("HMD Hub loaded!", false)
updateLayout()
