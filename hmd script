							table.remove(settings.favorites, idx)
							star.Text = "☆"
							showNotification(t("removedFromFavorites"), false)
						else
							table.insert(settings.favorites, data.name)
							star.Text = "★"
							showNotification(t("addedToFavorites"), false)
						end
