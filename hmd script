-- =====================
-- FILTER & LAYOUT
-- =====================
local function filterButtons(filter, search)
	local visible = {}
	search = search and search:lower() or ""
	
	for _, btnInfo in ipairs(buttons) do
		local show = true
		local data = btnInfo.data
		
		if filter == "favorites" then
			show = table.find(settings.favorites, data.name) ~= nil
		elseif filter == "recent" then
			show = table.find(settings.recentlyUsed, data.name) ~= nil
		end
		
		if show and search ~= "" then
			show = data.name:lower():find(search) ~= nil
		end
		
		btnInfo.button.Visible = show
		if show then
			table.insert(visible, btnInfo)
		end
	end
	
	-- Sort: pinned first
	table.sort(visible, function(a, b)
		local aPin = table.find(settings.pinned, a.data.name) ~= nil
		local bPin = table.find(settings.pinned, b.data.name) ~= nil
		if aPin and not bPin then return true end
		if not aPin and bPin then return false end
		return false
	end)
	
	return visible
end

local function updateLayout()
	local visible = filterButtons(currentFilter, searchBar.Text)
	local w = scrollFrame.AbsoluteSize.X
	local pad = 12
	local scrollW = 12
	
	if settings.viewMode == "grid" then
		local cols = settings.compactMode and 3 or 2
		local btnW = (w - scrollW - (cols + 1) * pad) / cols
		local btnH = settings.compactMode and 40 or 52
		local txtSize = settings.compactMode and 12 or 15
		
		for i, btnInfo in ipairs(visible) do
			local col = (i - 1) % cols
			local row = math.floor((i - 1) / cols)
			btnInfo.button.Size = UDim2.new(0, btnW, 0, btnH)
			btnInfo.button.Position = UDim2.new(0, pad + col * (btnW + pad), 0, pad + row * (btnH + pad))
			btnInfo.button.TextSize = txtSize
		end
		
		local rows = math.ceil(#visible / cols)
		scrollFrame.CanvasSize = UDim2.new(0, 0, 0, pad + rows * (btnH + pad))
	else
		local btnW = w - scrollW - 20
		local btnH = settings.compactMode and 32 or 38
		local txtSize = settings.compactMode and 13 or 15
		
		for i, btnInfo in ipairs(visible) do
			btnInfo.button.Size = UDim2.new(0, btnW, 0, btnH)
			btnInfo.button.Position = UDim2.new(0, 10, 0, (i - 1) * (btnH + 5) + 5)
			btnInfo.button.TextSize = txtSize
		end
		
		scrollFrame.CanvasSize = UDim2.new(0, 0, 0, #visible * (btnH + 5) + 10)
	end
end

