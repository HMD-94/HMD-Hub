local currentPanel = nil

local function showPanel(panel)
	if currentPanel then
		currentPanel.Visible = false
	end
	
	if panel then
		panel.Visible = true
		scrollFrame.Visible = false
		currentPanel = panel
	else
		scrollFrame.Visible = true
		currentPanel = nil
	end
end

