local function addToHistory(name)
	if not settings.executionHistory[name] then
		settings.executionHistory[name] = {}
	end
	table.insert(settings.executionHistory[name], os.time())
	saveSettings()
end

local function createScriptBtn(data)
	local btn = Instance.new("TextButton")
	btn.Text = data.name
	btn.BackgroundColor3 = Color3.fromRGB(15,15,15)
	btn.BorderSizePixel = 3
	btn.Font = Enum.Font.SourceSans
	btn.TextWrapped = true
	btn.TextColor3 = Color3.new(1,1,1)
	btn.ZIndex = 3
	
	local isFav = table.find(settings.favorites, data.name) ~= nil
	local isPin = table.find(settings.pinned, data.name) ~= nil
	
	-- Pin icon
	local pin = Instance.new("TextLabel")
	pin.Parent = btn
	pin.Size = UDim2.new(0, 18, 0, 18)
	pin.Position = UDim2.new(0, 2, 0, 2)
	pin.BackgroundTransparency = 1
	pin.Text = isPin and "📌" or ""
	pin.TextSize = 12
	pin.ZIndex = 5
	
	-- Star icon
	local star = Instance.new("TextLabel")
	star.Parent = btn
	star.Size = UDim2.new(0, 20, 0, 20)
	star.Position = UDim2.new(1, -22, 0, 2)
	star.BackgroundTransparency = 1
	star.Text = isFav and "★" or "☆"
	star.TextSize = 16
	star.TextColor3 = Color3.fromRGB(255, 215, 0)
	star.ZIndex = 5
	
	-- Rating
	local rating = settings.ratings[data.name] or 0
	local ratingLbl = Instance.new("TextLabel")
	ratingLbl.Parent = btn
	ratingLbl.Size = UDim2.new(0, 50, 0, 12)
	ratingLbl.Position = UDim2.new(0, 3, 1, -14)
	ratingLbl.BackgroundTransparency = 1
	ratingLbl.Text = string.rep("⭐", rating)
	ratingLbl.TextSize = 9
	ratingLbl.TextXAlignment = Enum.TextXAlignment.Left
	ratingLbl.ZIndex = 5
	
	-- Execution count
	local execCount = settings.executionHistory[data.name] and #settings.executionHistory[data.name] or 0
	local countLbl = Instance.new("TextLabel")
	countLbl.Parent = btn
	countLbl.Size = UDim2.new(0, 35, 0, 12)
	countLbl.Position = UDim2.new(1, -38, 1, -14)
	countLbl.BackgroundTransparency = 1
	countLbl.Text = "×" .. execCount
	countLbl.TextSize = 10
	countLbl.TextColor3 = Color3.fromRGB(150, 150, 150)
	countLbl.TextXAlignment = Enum.TextXAlignment.Right
	countLbl.ZIndex = 5
	
	-- Click to execute
	btn.MouseButton1Click:Connect(function()
		if table.find(settings.blacklist, data.name) then
			showNotification("Script is blacklisted!", true)
			return
		end
		
		if settings.safeMode then
			showNotification("Safe mode - blocked", true)
			return
		end
		
		playSound("click")
		
		local success, err = pcall(function()
			loadstring(game:HttpGet(data.url))()
		end)
		
		if success then
			showNotification("✓ " .. data.name .. " loaded!", false)
			
			table.insert(settings.recentlyUsed, 1, data.name)
			if #settings.recentlyUsed > 10 then
				table.remove(settings.recentlyUsed, 11)
			end
			
			addToHistory(data.name)
			saveSettings()
		else
			showNotification("✗ Failed: " .. data.name, true)
		end
	end)
	
	-- Long press for mobile / right-click for PC
	local holding = false
	local holdTime = 0
	
	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton2 then
			holding = true
			holdTime = 0
			
			task.spawn(function()
				while holding do
					task.wait(0.1)
					holdTime = holdTime + 0.1
					
					if holdTime >= 0.5 then
						holding = false
						
						-- Toggle favorite
						local idx = table.find(settings.favorites, data.name)
						if idx then
							table.remove(settings.favorites, idx)
							star.Text = "☆"
							showNotification("Removed from favorites", false)
						else
							table.insert(settings.favorites, data.name)
							star.Text = "★"
							showNotification("Added to favorites", false)
						end
						saveSettings()
						break
					end
				end
			end)
		end
	end)
	
	btn.InputEnded:Connect(function(input)
		holding = false
	end)
	
	return btn, data
end

