local hue = 0
RunService.RenderStepped:Connect(function()
	local theme = themes[settings.theme]
	local color
	
	if theme.animated then
		hue = (hue + 0.003) % 1
		color = Color3.fromHSV(hue, 1, 1)
	else
		color = theme.primary
	end
	
	frame.BorderColor3 = color
	titler.BorderColor3 = color
	titler.TextColor3 = color
	collapseBtn.TextColor3 = color
	resizeBtn.TextColor3 = color
	resizeBtn.BorderColor3 = color
	scrollFrame.ScrollBarImageColor3 = color
	searchBar.BorderColor3 = color
	
	for _, btnInfo in ipairs(buttons) do
		if btnInfo.button.Visible and not table.find(settings.blacklist, btnInfo.data.name) then
			btnInfo.button.BorderColor3 = color
		end
	end
	
	updateLayout()
end)

