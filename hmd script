-- =====================
-- RESIZE LOGIC
-- =====================
local resizing = false
local resizeConnection = nil
local resizeEndConnection = nil

local function setupResize(inputObject)
	if collapsed then
		collapsed = false
		collapseBtn.Text = "—"
		scrollFrame.Visible = not settingsPanel.Visible
		buttonBar.Visible = true
		searchBar.Visible = true
		resizeSlider.Visible = true
		frame.Size = lastSize
	end
	
	resizing = true
	frame.Draggable = false
	
	local startSize = frame.Size
	local startPos = inputObject.Position
	
	if resizeConnection then resizeConnection:Disconnect() end
	if resizeEndConnection then resizeEndConnection:Disconnect() end
	
	resizeConnection = UserInputService.InputChanged:Connect(function(input)
		if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - startPos
			local newX = math.clamp(startSize.X.Offset + delta.X, 300, 900)
			local newY = math.clamp(startSize.Y.Offset + delta.Y, 250, 700)
			frame.Size = UDim2.new(0, newX, 0, newY)
		end
	end)
	
	resizeEndConnection = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			resizing = false
			frame.Draggable = true
			settings.savedSize = frame.Size
			if writefile then saveSettings() end
			if resizeConnection then
				resizeConnection:Disconnect()
				resizeConnection = nil
			end
			if resizeEndConnection then
				resizeEndConnection:Disconnect()
				resizeEndConnection = nil
			end
		end
	end)
end

resizeSlider.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		setupResize(input)
	end
end)

