local function saveSettings()
	if writefile then
		pcall(function()
			writefile("HMD_Settings.json", HttpService:JSONEncode(settings))
		end)
	end
end

local function loadSettings()
	if readfile and isfile and isfile("HMD_Settings.json") then
		local success, data = pcall(function()
			return HttpService:JSONDecode(readfile("HMD_Settings.json"))
		end)
		if success and data then
			for k, v in pairs(data) do
				settings[k] = v
